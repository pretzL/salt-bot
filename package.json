{
  "name": "salt-bot",
  "version": "1.0.0",
  "description": "Personal Discord bot",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "deploy-commands": "node --env-file-if-exists=.env deploy-commands.js",
    "test": "node --test",
    "prepare": "husky",
    "lint:commit": "commitlint --last",
    "lint:commits": "commitlint --from origin/main --to HEAD"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pretzL/salt-bot.git"
  },
  "keywords": [
    "discord",
    "bot"
  ],
  "author": "pretzL",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pretzL/salt-bot/issues"
  },
  "homepage": "https://github.com/pretzL/salt-bot#readme",
  "dependencies": {
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
