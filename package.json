{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "discord bot testing",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "deploy-commands": "node --env-file-if-exists=.env deploy-commands.js",
    "test": "node --test",
    "prepare": "husky",
    "lint:commit": "commitlint --last",
    "lint:commits": "commitlint --from origin/main --to HEAD"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pretzL/discord-bot.git"
  },
  "keywords": [
    "discord",
    "bot",
    "testing"
  ],
  "author": "pretzL",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pretzL/discord-bot/issues"
  },
  "homepage": "https://github.com/pretzL/discord-bot#readme",
  "dependencies": {
    "dadjokes-wrapper": "^0.1.4",
    "discord.js": "^14.6.0",
    "express": "^4.18.2",
    "firebase": "^9.15.0",
    "nodemon": "^2.0.20",
    "vite": "^3.1.8"
  },
  "devDependencies": {
    "dotenv": "^16.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7"
  }
}
